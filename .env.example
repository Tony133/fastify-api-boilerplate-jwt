LOG_LEVEL=debug

FASTIFY_PORT=3000
FASTIFY_CLOSE_GRACE_DELAY=500
FASTIFY_ADDRESS=0.0.0.0

SWAGGER_USER=""
SWAGGER_PASSWORD=""

EXPOSE_ERROR_DETAILS=true

SECRET_KEY_JWT=
JWT_ACCESS_TOKEN_EXPIRES_IN=2h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_backend
DB_USER=postgres
DB_PASSWORD=pass123
DB_POOL_MAX=10

# Email
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_AUTH_USER=""
EMAIL_AUTH_PASSWORD=""
EMAIL_FROM_NAME="App Fastify"
EMAIL_FROM_EMAIL="noreply@example.com"
EMAIL_DEBUG=false
EMAIL_LOGGER=false
