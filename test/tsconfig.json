{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist-test",
    "sourceMap": true,
    "importHelpers": true,
    "noUnusedLocals": false,
    "typeRoots": ["../node_modules/@types", "../@types"]
  },
  "include": ["../@types", "../src/**/*.ts", "**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../dist-test"]
}
